# Ignore everything
/*

# Keep this file
!.gitignore

############################################
# Strict allow-list for GitHub repository  #
############################################

# Essentials
!README.md
!requirements.txt

# Keep modules (all)
!modules/
!modules/**

# Keep only the single script
!scripts/
!scripts/run_complete_analysis.py

# Keep only the single notebook
!notebooks/
!notebooks/Photonic_Cavity_Workflow.ipynb

# Keep all GDS files
!gds/
!gds/**

# Keep only 0.19 µm results under data/results
!data/
!data/results/
!data/results/*0.19*.hdf5

# Explicitly ignore everything else inside data
/data/**
!/data/results/
!/data/results/*0.19*.hdf5

# Ignore figures and logs entirely
figures/**
logs/**

# Do not keep other scripts or notebooks
scripts/**
!/scripts/run_complete_analysis.py
notebooks/**
!/notebooks/Photonic_Cavity_Workflow.ipynb

# Python/build artifacts
__pycache__/**
*.pyc
*.pyo
*.pyd
*.egg-info/**
.build/**
build/**
dist/**
.DS_Store
